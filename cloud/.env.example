# ros.ai cloud settings. Copy to .env for a local run; on a host, set these as its variables.
DATABASE_URL=postgres://user:password@host:5432/roscloud
# At least 32 random characters: openssl rand -hex 32
BETTER_AUTH_SECRET=
# The public address people open to sign in; the app's ROS_CLOUD_URL points here too.
ROS_CLOUD_URL=http://127.0.0.1:4400
# The provider key. It lives only in this service, never in the app or the repository.
NEBIUS_API_KEY=
# Sign-in methods: each is on when both of its values are set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 1 turns on email and password, for test accounts until sign-in links by email exist.
ROS_CLOUD_EMAIL_PASSWORD=0
# The free allowance: per workspace per day, and in total.
ROS_CLOUD_DAILY_USD=0.5
ROS_CLOUD_POOL_USD=100
# Error reports (Sentry, EU region DSN). Off when empty; bodies, cookies, headers and addresses are never sent.
SENTRY_DSN=

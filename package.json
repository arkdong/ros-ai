{
  "name": "ros-ai",
  "version": "0.1.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "bin": {
    "ros-ai": "bin/ros-ai.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx src/server/index.ts",
    "dev": "ROS_DEV=1 tsx src/server/index.ts",

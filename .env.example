# Optional settings for a checkout. Copy to .env.local, which stays on this computer and is never committed.
# Most people need none of this: keys can be pasted on the Agents and Plugins pages,
# or kept once for every data folder in ~/.config/ros.ai/keys.env (see README, "Keys, data and updates").
# These are read by the server only. Never use a VITE_ prefix.

# Model and search keys.
NEBIUS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=

# Google Drive, Sheets and Docs: your own Google OAuth Web application. The Plugins page can save these too.
# Enable the Drive API and register http://127.0.0.1:4310/api/connections/google-drive/callback
# (with your own ROS_PORT), and add your account as a test user while the app is in testing.
ROS_GOOGLE_CLIENT_ID=
ROS_GOOGLE_CLIENT_SECRET=

# Where ros.ai listens and keeps its data. Defaults: port 4310, and .ros-ai/ in a checkout that has one.
# ROS_PORT=4310
# ROS_DATA_DIR=/absolute/path/to/ros-ai-data

# The Nebius model used when a project has not chosen one.
# ROS_NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Agent binaries that are not on PATH.
# ROS_CODEX_BINARY=
# ROS_CLAUDE_BINARY=

# Switches. Each line turns one thing off.
# ROS_NO_DETECT=1        # skip the first-launch scan for installed agents, model servers and apps
# ROS_CLOUD_URL=off      # hide ros.ai cloud (sign-in and hosted ROS)
# ROS_FREE_SEARCH=off    # no keyless web search
# ROS_UPDATE_URL=off     # never check for a newer release
# ROS_KEYS_FILE=off      # do not read ~/.config/ros.ai/keys.env

# Development only: Vite live reload instead of the built page (`npm run dev` sets it).
# ROS_DEV=1

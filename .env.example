# Server-only credentials. Copy only if .env.local does not already exist.
# Never use VITE_ prefixes. Existing .env.local must not be overwritten.
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
OPENAI_API_KEY=
TAVILY_API_KEY=
# Or save API keys privately from the local Connections panel without restarting,
# or once for every data folder in ~/.config/ros.ai/keys.env (see README, Keys in one file).
# Claude authentication setup only; embedded Claude turns remain unavailable.
ANTHROPIC_API_KEY=
# Optional Google OAuth Web application. The panel can also save these locally.
# Enable Drive API and register http://127.0.0.1:4310/api/connections/google-drive/callback
# (use your actual local host/ROS_PORT). Add your account as a test user in testing.
ROS_GOOGLE_CLIENT_ID=
ROS_GOOGLE_CLIENT_SECRET=

# Exact Ultra ID verified in the authenticated us-central1 catalog September 21.
# No fallback to the historical NEBIUS_MODEL/Qwen setting.
ROS_NEBIUS_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Paid calls are disabled by default. Only configure after fresh explicit user
# authorization for a concrete scope, provider ceilings, and maximum call count.
# Keep the SAME authorization ID across restarts; never rotate it to reset usage.
# Prior NEBIUS_BUDGET_USD/TAVILY_BUDGET_USD are historical, not authorization.
# ROS_PAID_AUTHORIZATION_ID=
# ROS_NEBIUS_AUTHORIZED_USD=0
# ROS_TAVILY_AUTHORIZED_USD=0
# ROS_PAID_MAX_REQUESTS=1
# OpenAI has its own explicit grant; Nebius/Tavily allowances never fund it.
# ROS_OPENAI_AUTHORIZATION_ID=
# ROS_OPENAI_AUTHORIZED_USD=0
# ROS_OPENAI_MAX_REQUESTS=1
ROS_MAX_CONCURRENT=2

# September 22 continuous-assistant build: ONE additional ceiling, at most US$10,
# shared by all new Nebius inference AND sandbox attempts across every project.
# It is not US$10 for each service, and an account balance is not authorization.
# Provider-specific grants/request counts and project limits still apply.
# Leave blank/zero to disable; copying this example does not authorize spending.
# After authorization, preserve the same ID AND ceiling: changing either after
# first use is rejected. Keep the existing data directory and historical grants.
# ROS_NEBIUS_COMBINED_AUTHORIZATION_ID=
# ROS_NEBIUS_COMBINED_AUTHORIZED_USD=0
# Tavily is separate: its existing cumulative US$10 ceiling includes prior usage.
# A new Nebius grant does not reset or add to the Tavily allowance.

# Nebius Sandboxes is a separate remote execution backend. The default image is
# Python 3.12-slim, pinned by UUID; pandas/NumPy/SciPy/Matplotlib are not installed.
# Override only with a verified compatible image; no image is imported for you.
# ROS_NEBIUS_SANDBOX_IMAGE_ID=4fa16c8f-62a9-35a4-a4ea-07b7e8cd44ae
# Remote execution is currently blocked: pricing/units and free-beta terms have
# not been established. Keep these fields unset until a verified upper bound for
# ALL applicable charges exists and exact remote execution is authorized.
# The sandbox ceiling below is a sublimit inside the combined Nebius US$10 grant,
# never an additional US$10. A combined/inference grant alone cannot enable it.
# Account balance is neither a sandbox allowance nor a price per attempt.
# Keep the SAME ID across restarts; failed/cancelled/uncertain runs keep reserves.
# ROS_NEBIUS_SANDBOX_AUTHORIZATION_ID=
# ROS_NEBIUS_SANDBOX_MAX_RUNS=
# ROS_NEBIUS_SANDBOX_AUTHORIZED_USD=
# ROS_NEBIUS_SANDBOX_MAX_COST_PER_RUN_USD=
# ROS_NEBIUS_SANDBOX_PRICING_BASIS=
# Zero USD requires a documented free allowance; free beta is NOT established.
# See docs/nebius-sandbox-setup.md before enabling remote execution.

# Default: loopback port 4310 and repository-local .ros-ai data.
# ROS_PORT=4310
# ROS_DATA_DIR=/absolute/path/to/private/ros-ai-data

# Read-only provider usage sync. Enable only after authorization.
ROS_TAVILY_USAGE_SYNC=0

# Optional local agent binaries (defaults: `codex` and `claude` on PATH).
# ROS_CODEX_BINARY=
# ROS_CLAUDE_BINARY=

# Development only: Vite live reload instead of the built frontend (`npm run dev`).
# ROS_DEV=1

# Curated public demo (Dockerfile/Railway). Never combine with ROS_DEV.
# ROS_PUBLIC_DEMO=1
# ROS_PUBLIC_ORIGIN=https://your-demo.example   # or RAILWAY_PUBLIC_DOMAIN
# ROS_PUBLIC_MAX_SESSIONS=500
# ROS_PUBLIC_SESSION_DAYS=7
